        },
        "position": {
          "x": 300,
          "y": 50
        }
      },
      {
        "id": "gen_1788880484790_2",
        "type": "condition",
        "label": "Status = Draft?",
        "position": {
          "x": 300,
          "y": 160
        },
        "condition": {
          "logic": "and",
          "rules": [
            {
              "field": "triggerData.status",
              "value": "0",
              "operator": "equals"
            }
          ]
        }
      },
