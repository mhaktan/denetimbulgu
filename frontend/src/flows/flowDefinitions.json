                  "type": "approve",
                  "label": "Onayla"
                }
              ],
              "assigneeType": "role",
              "assigneeValue": "QualityManager"
            }
          ],
          "onCompleteEvent": "AuditPlan-approval-completed",
          "trackRevisionHistory": false
        },
        "position": {
          "x": 300,
          "y": 280
        }
      },
      {
        "id": "gen_1788880484790_6",
        "type": "action",
        "label": "Send Approval Email",
        "action": {
          "type": "send-email",
          "config": {
            "to": "{{assigneeEmail}}",
